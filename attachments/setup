# Future reserved-slot setup only; execute nothing during planning.
nf5_voice_evidence="/Users/hughpyle/play/artroom-evidence/<new-UTC-stamp>-nf5-voice"
nf5_voice_scratch="$nf5_voice_evidence/scratch"
mkdir -p "$nf5_voice_scratch/native-tmp" "$nf5_voice_scratch/statechart-stage"
export TLA2TOOLS=/tmp/artroom-formal-tools/jar/tla2tools.jar
export JAVA=/tmp/artroom-formal-tools/mise/installs/java/temurin-25.0.5+8.0.LTS/bin/java
export TMPDIR="$nf5_voice_scratch/native-tmp"
python3 - /Users/hughpyle/.codex/skills/statechart/scripts "$nf5_voice_scratch" <<'PY'
from pathlib import Path
from hashlib import sha256
import shutil, sys
source, scratch = map(Path, sys.argv[1:])
original, copied = scratch / "tool-original", scratch / "tool"
def manifest(base):
    return {p.relative_to(base).as_posix(): sha256(p.read_bytes()).hexdigest()
            for p in sorted(base.rglob("*")) if p.is_file()}
def save(label, values):
    (scratch / label).write_text("".join(f"{digest}  {name}\n"
        for name, digest in sorted(values.items())), encoding="utf-8")
home = manifest(source)
save("tool-home.sha256", home)
shutil.copytree(source, original)
shutil.copytree(original, copied)
before = manifest(copied)
assert home == manifest(original) == before
save("tool-original.sha256", manifest(original))
save("tool-copy-before.sha256", before)
run = copied / "run.ts"
raw = run.read_bytes()
assert sha256(raw).hexdigest() == "f330e0a3b0a9f8181c2e52252c4a47db3f0a64f79a7cca5490263e33a5f13c72"
old = b"    fs.rmSync(dir, { recursive: true, force: true });"
new = b"    void dir; // Preserve TLC scratch."
assert raw.count(old) == 1
run.write_bytes(raw.replace(old, new, 1))
assert sha256(run.read_bytes()).hexdigest() == "f94caefd386fd742a0a72e748935fd247985e00ed86d2cd1610c9a9ff7032e09"
after = manifest(copied)
assert sorted(name for name in before if before[name] != after[name]) == ["run.ts"]
assert set(before) == set(after)
assert manifest(source) == home
save("tool-copy-after.sha256", after)
PY
cp verification/state-machines/Voice/Voice.tla "$nf5_voice_scratch/Voice.tla"
cp verification/state-machines/Voice/Voice.cfg "$nf5_voice_scratch/Voice.cfg"
cp verification/state-machines/Voice/view.mjs "$nf5_voice_scratch/view.mjs"
# Check model/cfg/view hashes against the plan before any helper invocation.
