landing. The landing changes Worker code in `packages/scope`, so a deploy round follows. The deploy is the planner's.","body":{"artifact":"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:35d7caa3a3ca16349f7b0f97e0f3836e227c51f5","binding":"assigned","head":"f2ae898058587c87b573e7408c4700dbd1ec211a","head_news_acknowledged":"[\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:ee0143e315e7cae990065cd3302547e2958768d9\"]","implementations":"[\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:fcbad7a64c74f9c6fcb5c32883b3f955d73a3ce1\"]","review_frontier":"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:ee0143e315e7cae990065cd3302547e2958768d9","review_path":"reviewguard@1","verdict":"approved"}}