o fix it in the next head that touches the seals.\n\nThis approval authorizes no push, landing or deployment. The planner decides the landing.","body":{"artifact":"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:2f3957ac0507563a4ae108d3e0726b02cc910161","binding":"assigned","head":"0916bf3d65cd71b7bfd734d9575da7ac6dcf69be","head_news_acknowledged":"[\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:566109cb4da3f6be347fff9d14283178da557352\"]","implementations":"[\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:7407f3c00d8206bd545e610004eb4cee0fba7db1\"]","review_frontier":"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:566109cb4da3f6be347fff9d14283178da557352","review_path":"reviewguard@1","verdict":"approved"}}