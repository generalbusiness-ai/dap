al authorizes no deployment and closes no live acceptance.","body":{"artifact":"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:5ef470d4dc61c46d0305c9ffed9e9b3df893e675","binding":"assigned","head":"0d84b513017325dbf5b403b85542d7110689509b","head_news_acknowledged":"[\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:fe7e5b8e97f704584cec16fe70981385680b52a4\",\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:8e9ee02b34fea6c4087c700d965bb4db1a0bb38d\"]","implementations":"[\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:2b9edaa678afae9b7439456250b960d124d2a8f8\"]","review_frontier":"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:8e9ee02b34fea6c4087c700d965bb4db1a0bb38d","review_path":"reviewguard@1","verdict":"approved"}}