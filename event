t the next edit so the Status sentence and the heading agree.\n\nNo gate is required: the head changes one notes file.","body":{"artifact":"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:9ac96a7170fe9dbac8bf18aabba5b1d3952ccbbf","binding":"assigned","head":"f235ad071bdebdde14cd93631173f7d44aeee4d7","head_news_acknowledged":"[\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:6d02f7ba067a7b3b706cb5f8a301142eda51fb35\"]","implementations":"[\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:adf6f94b490e85529ac1dccc00e093fd2a8fff9e\"]","review_frontier":"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:bed55162952736db2063cdc60159c881b9adb4fc","review_path":"reviewguard@1","verdict":"approved"}}