ing and the order of the two heads.","body":{"artifact":"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:d29ce6474e62baf30c83d185e5ebad8f1bda41ae","binding":"assigned","head":"4eccee225722015c57870448a0510202c3ced85b","head_news_acknowledged":"[\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:7b1c71610a8f71d08525b9f8412706b22ac1ba4c\"]","implementations":"[\"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:2de785274654e85c14be9398b01b7457a5421e02\"]","review_frontier":"git:sha1:589bca982736a2361d15d53f7572375ef2f7aaf3#git:sha1:d5817862e11b14653fadb76bac71a847432fb812","review_path":"reviewguard@1","verdict":"approved"}}