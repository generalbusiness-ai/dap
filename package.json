{
  "name": "artroom",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/room/lanes",
    "apps/room/page"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json && tsc -p apps/counter/tsconfig.json && tsc -p examples/lending/tsconfig.json && tsc -p examples/lending/browser/tsconfig.json && tsc -p apps/counter/browser/tsconfig.json && tsc -p examples/grow/tsconfig.json && tsc -p apps/sandbox/tsconfig.json && tsc -p examples/commons-bill/tsconfig.json",
    "pretest": "node scripts/cloudflare-pool-compat.mjs",
    "test": "node scripts/test.mjs",
    "pretest:changed": "node scripts/cloudflare-pool-compat.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "gate": "bash scripts/gate.sh",
    "build:brand": "node scripts/brand-assets.mjs",
    "build:home": "node homepage/build.mjs",
    "deploy:scope": "npx -y wrangler@4.147.0 deploy --keep-vars --config apps/room/wrangler.jsonc",
    "deploy:home": "cd homepage && npx -y wrangler@4.147.0 deploy"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  }
}
