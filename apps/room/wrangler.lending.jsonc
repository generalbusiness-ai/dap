// Historical service configuration; not the generic M1 deployment target.
// The lending library's deployment of the scope Worker: Worker dap-lending at https://dap-lending.inguz.workers.dev, with its own
// Durable Object namespace and Artifacts namespace. ARTIFACTS_CONFIG names the register of the library's room, created after the
// first deployment (examples/lending/runbook.md). Deploy from apps/room with
// `npx -y wrangler@4.147.0 deploy --keep-vars --config wrangler.lending.jsonc`. DEPLOYMENT and SESSION_SECRET are existing secret bindings; preserve them.
{
  "name": "dap-lending",
  "main": "worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "version_metadata": { "binding": "VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "SCOPES", "class_name": "DeployedScope" }, { "name": "SCOPE_INDEX", "class_name": "ScopeIndex" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeployedScope"] }, { "tag": "v2-scope-index", "new_sqlite_classes": ["ScopeIndex"] }],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "dap-lending", "remote": true }],
  "r2_buckets": [{ "binding": "APPLICATION_CONTENT", "bucket_name": "dap-lending-application-content" }],
  "vars": {
    "INSTALLED_REGISTER_SCOPES": "[\"sc_psbin3zi4ld7kqxg4vdbmb2eudyca64e5mxarz3k4qmklrpyfokq\"]",
    // Recorded live mode; preserve enforced admission on deployment.
    "SCOPE_INDEX_MODE": "enforce",
    "PLATFORM_CREATION_PINS": "[\"platform:register@28\",\"platform:directory@27\",\"platform:membership@14\",\"platform:rules@15\",\"platform:destination@21\",\"platform:register@5\",\"platform:directory@5\",\"platform:membership@4\",\"platform:rules@3\",\"platform:destination@2\",\"platform:inbox@1\"]",
    // The planner creates this private content bucket before deployment.
    // Screen hosts and install contexts follow under separate requests.
    "APPLICATION_SCREEN_HOSTS": "[]",
    "APPLICATION_TRUST": "[{\"release\":\"sha256:93819e267db04a8615dc63c202e39622fbca47cb2ca4aee58d221fd9cb679824\",\"publisher\":\"key_qNT9aIt0WhJndvMP7UV33FFJ7DOYwW0JUvOv4PhNlFI\",\"host\":\"github.com\"},{\"release\":\"sha256:f681c1b5615139d76ee8612a1d253b6d314f200cb8dd0686c18cd6bf399aef0c\",\"publisher\":\"key_qNT9aIt0WhJndvMP7UV33FFJ7DOYwW0JUvOv4PhNlFI\",\"host\":\"github.com\"}]",
    "SERVING_CREATION_KEY_PER_HOUR": "10",
    "SERVING_CREATION_ADDRESS_PER_HOUR": "30",
    "SERVING_READ_KEY_PER_MINUTE": "240",
    "SERVING_READ_ADDRESS_PER_MINUTE": "600",
    "ARTIFACTS_NAMESPACE": "dap-lending",
    "REGISTER_SCOPE": "sc_psbin3zi4ld7kqxg4vdbmb2eudyca64e5mxarz3k4qmklrpyfokq",
    "ARTIFACTS_CONFIG": "{\"registerScope\":\"sc_psbin3zi4ld7kqxg4vdbmb2eudyca64e5mxarz3k4qmklrpyfokq\",\"namespace\":\"dap-lending\",\"host\":\"6e953d231f1c9aadffbf59537a82e13a.artifacts.cloudflare.net\",\"maxBytes\":10485760,\"credentialIdentity\":\"adapter-attempt\"}"
  }
}
