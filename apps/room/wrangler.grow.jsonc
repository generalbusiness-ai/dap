// Grow's scope Worker at https://dap-grow.inguz.workers.dev.
// Deploy from a scratch directory with the pinned tool:
// npx -y wrangler@4.147.0 deploy --keep-vars --config /absolute/path/to/artroom/apps/room/wrangler.grow.jsonc
// Set SESSION_SECRET separately from stdin.
// Durable Objects and Register17 belong to this Worker. The artroom-demo
// Artifacts namespace and application-content bucket are shared.
{
  "name": "dap-grow",
  "main": "worker.grow.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.dap.json"], "fallthrough": true }],
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat", "enable_request_signal"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "artroom_metrics_v1"
    }
  ],
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  "r2_buckets": [
    {
      "binding": "APPLICATION_CONTENT",
      "bucket_name": "artroom-application-content"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SCOPE_INDEX", "class_name": "ScopeIndex" },
      {
        "name": "SCOPES",
        "class_name": "DeployedScope"
      },
      {
        "name": "REGISTRIES",
        "class_name": "McpRegistry"
      },
      {
        "name": "AGENTS",
        "class_name": "McpAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeployedScope"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "McpRegistry",
        "McpAgent"
      ]
    },
    { "tag": "v3-scope-index", "new_sqlite_classes": ["ScopeIndex"] }
  ],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "artroom-demo",
      "remote": true
    }
  ],
  "vars": {
    "INSTALLED_REGISTER_SCOPES": "[\"sc_wmtd3fkl2cwafzzredeicmrdhtdo2ics6n7kezy6ds4rxaqvaxoa\"]",
    // Recorded live mode; preserve enforced admission on deployment.
    "SCOPE_INDEX_MODE": "enforce",
    "PLATFORM_CREATION_PINS": "[\"platform:register@28\",\"platform:directory@27\",\"platform:membership@14\",\"platform:rules@15\",\"platform:destination@21\",\"platform:register@17\",\"platform:directory@16\",\"platform:membership@8\",\"platform:rules@10\",\"platform:destination@12\",\"platform:inbox@1\"]",
    // Planner-confirmed item 2 and release. This serves the unchanged
    // placeholder at its sandbox origin, not a standalone Grow UI.
    "APPLICATION_SCREEN_HOSTS": "[{\"v\":1,\"screenOrigin\":\"https://grow.inguz.space\",\"roomOrigin\":\"https://dap-grow.inguz.workers.dev\",\"directory\":\"sc_ryghgistvpshbaznxlbleop5zqruy2kmogy4jeigr7j3yqlewceq\",\"item\":2,\"presentation\":\"sha256:5bd818a796771c0b6bdd6eac7d5b0fe6ed70358ddc2c33dec82bfd11cd558cf4\"}]",
    "SERVING_CREATION_KEY_PER_HOUR": "10",
    "SERVING_CREATION_ADDRESS_PER_HOUR": "30",
    "SERVING_READ_KEY_PER_MINUTE": "240",
    "SERVING_READ_ADDRESS_PER_MINUTE": "600",
    "GROW_ARCHIVE_CONFIG": "{\"policy\":\"grow-room-archive-1\",\"release\":\"sha256:71e10ca9499e926a4de1d8294ed83a772051dff677d8b1687bbd8e28e61802fa\",\"directory\":\"sc_ryghgistvpshbaznxlbleop5zqruy2kmogy4jeigr7j3yqlewceq\",\"repositoryName\":\"ryghgistvpshbaznxlbleop5zqruy2kmogy4jeigr7j3yqlewceq-1\"}",
    "DEPLOYMENT": "dap-grow-v1",
    "REGISTER_SCOPE": "sc_wmtd3fkl2cwafzzredeicmrdhtdo2ics6n7kezy6ds4rxaqvaxoa",
    "ARTIFACTS_CONFIG": "{\"registerScope\":\"sc_wmtd3fkl2cwafzzredeicmrdhtdo2ics6n7kezy6ds4rxaqvaxoa\",\"namespace\":\"artroom-demo\",\"host\":\"6e953d231f1c9aadffbf59537a82e13a.artifacts.cloudflare.net\",\"maxBytes\":10485760,\"credentialIdentity\":\"adapter-attempt\"}",
    "APPLICATION_TRUST": "[{\"release\":\"sha256:482f8605c24a9acb82cc673800831f424efe96179b21d8d33d96dc2b3ee213c9\",\"publisher\":\"key_qNT9aIt0WhJndvMP7UV33FFJ7DOYwW0JUvOv4PhNlFI\",\"host\":\"github.com\"}]"
  }
}
