// File-owned register settings agree with the dap-demo Artifacts namespace.
// register-values.mjs updates the primary and installed roots together. An
// optional Start setting records the full reference and deployment identity.
// DEPLOYMENT remains an operator-set secret binding, checked explicitly when
// updating Start. SESSION_SECRET stays private.
// Planner preserves this Worker's private namespaces, enforced index and limits.
{
  "name": "dap-demo",
  "main": "worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "vars": {
    "DEMO_START_CONFIG": "{\"v\":3,\"origin\":\"https://dap-demo.inguz.workers.dev\",\"deployment\":\"dap-demo\",\"definition\":\"platform:register@28\",\"register\":{\"scope\":\"sc_dtqcta4htibueaeycfficyanudk5cz3ssrsugho3qlznvrhw3jxq\",\"genesis\":\"sha256:e1d53ac5241fad1445bd8963abbaa6c844c2dcdeced0c2495d3778fa190870b0\"}}",
    "SCOPE_INDEX_MODE": "enforce",
    "PLATFORM_CREATION_PINS": "[\"platform:register@28\",\"platform:directory@27\",\"platform:membership@14\",\"platform:rules@15\",\"platform:destination@21\",\"platform:register@17\",\"platform:directory@16\",\"platform:membership@8\",\"platform:rules@10\",\"platform:destination@12\",\"platform:inbox@1\"]",
    "ARTIFACTS_NAMESPACE": "dap-demo",
    "REGISTER_SCOPE": "sc_dtqcta4htibueaeycfficyanudk5cz3ssrsugho3qlznvrhw3jxq",
    "INSTALLED_REGISTER_SCOPES": "[\"sc_dtqcta4htibueaeycfficyanudk5cz3ssrsugho3qlznvrhw3jxq\"]",
    "ARTIFACTS_CONFIG": "{\"registerScope\":\"sc_dtqcta4htibueaeycfficyanudk5cz3ssrsugho3qlznvrhw3jxq\",\"namespace\":\"dap-demo\",\"host\":\"6e953d231f1c9aadffbf59537a82e13a.artifacts.cloudflare.net\",\"maxBytes\":10485760,\"credentialIdentity\":\"adapter-attempt\"}",
    "APPLICATION_SCREEN_HOSTS": "[]",
    "APPLICATION_TRUST": "[]",
    "SERVING_CREATION_KEY_PER_HOUR": "10",
    "SERVING_CREATION_ADDRESS_PER_HOUR": "30",
    "SERVING_READ_KEY_PER_MINUTE": "240",
    "SERVING_READ_ADDRESS_PER_MINUTE": "600"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "artroom_metrics_v1" }],
  "version_metadata": { "binding": "VERSION_METADATA" },
  "durable_objects": { "bindings": [
    { "name": "SCOPES", "class_name": "DeployedScope" },
    { "name": "SCOPE_INDEX", "class_name": "ScopeIndex" },
    { "name": "REGISTRIES", "class_name": "McpRegistry" },
    { "name": "AGENTS", "class_name": "McpAgent" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeployedScope", "ScopeIndex", "McpRegistry", "McpAgent"] }
  ],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "dap-demo", "remote": true }]
}
