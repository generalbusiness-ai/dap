// File-owned nonsecret DEMO_START_CONFIG and ARTIFACTS_CONFIG bind the planned
// Register17 and exact dap-demo origin. DEPLOYMENT and SESSION_SECRET remain
// secrets; the deployment value is already public in /health.
// Planner preserves this Worker's private namespaces, enforced index and limits.
{
  "name": "dap-demo",
  "main": "worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SCOPE_INDEX_MODE": "enforce",
    "PLATFORM_CREATION_PINS": "[\"platform:register@17\",\"platform:directory@16\",\"platform:membership@8\",\"platform:rules@10\",\"platform:destination@12\",\"platform:inbox@1\"]",
    "ARTIFACTS_NAMESPACE": "dap-demo",
    "ARTIFACTS_CONFIG": "{\"registerScope\":\"sc_b5q435os6lggypatelcltqzvul4kqxzdaaxpmybvwumsmxwj2djq\",\"namespace\":\"dap-demo\",\"host\":\"6e953d231f1c9aadffbf59537a82e13a.artifacts.cloudflare.net\",\"maxBytes\":10485760,\"credentialIdentity\":\"adapter-attempt\"}",
    "DEMO_START_CONFIG": "{\"v\":3,\"origin\":\"https://dap-demo.inguz.workers.dev\",\"deployment\":\"dap-demo\",\"register\":{\"inc\":\"in_rjfrmifznpi65vm6y2kbc36xpi\",\"kind\":\"register\",\"scope\":\"sc_b5q435os6lggypatelcltqzvul4kqxzdaaxpmybvwumsmxwj2djq\"},\"definition\":\"platform:register@17\"}",
    "APPLICATION_SCREEN_HOSTS": "[]",
    "APPLICATION_TRUST": "[{\"release\":\"sha256:71e10ca9499e926a4de1d8294ed83a772051dff677d8b1687bbd8e28e61802fa\",\"publisher\":\"key_gg4rXwy4v-kVqveN37_W_FW_-Wvsn3fgsal5z6gxfS0\",\"host\":\"github.com\"}]",
    "SERVING_CREATION_KEY_PER_HOUR": "10",
    "SERVING_CREATION_ADDRESS_PER_HOUR": "30",
    "SERVING_READ_KEY_PER_MINUTE": "240",
    "SERVING_READ_ADDRESS_PER_MINUTE": "600"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "artroom_metrics_v1" }],
  "version_metadata": { "binding": "VERSION_METADATA" },
  "durable_objects": { "bindings": [
    { "name": "SCOPES", "class_name": "DeployedScope" },
    { "name": "SCOPE_INDEX", "class_name": "ScopeIndex" },
    { "name": "REGISTRIES", "class_name": "McpRegistry" },
    { "name": "AGENTS", "class_name": "McpAgent" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeployedScope", "ScopeIndex", "McpRegistry", "McpAgent"] }
  ],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "dap-demo", "remote": true }]
}
