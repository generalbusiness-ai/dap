// The scopes that the lane scenarios run on, as the workerd test pool runs
// them (vitest.scope.config.ts): the scope package's test classes, in one
// namespace with real Durable Object SQLite storage, and the Worker's own
// entrypoint bound as a service. Nothing is deployed from this file.
{
  "name": "artroom-lanes-test",
  "main": "test/support/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // High finite shared-key fixture policy, not the adopted-default startup measurement.
  "vars": {
    "SERVING_CREATION_KEY_PER_HOUR": "1000000",
    "SERVING_CREATION_ADDRESS_PER_HOUR": "1000000",
    "SERVING_READ_KEY_PER_MINUTE": "1000000",
    "SERVING_READ_ADDRESS_PER_MINUTE": "1000000"
  },
  "durable_objects": {
    "bindings": [{ "name": "NET", "class_name": "NetScope" }, { "name": "PLATFORM", "class_name": "PlatformScope" }, { "name": "SCOPE_INDEX", "class_name": "ScopeIndex" }]
  },
  "r2_buckets": [{ "binding": "APPLICATION_CONTENT", "bucket_name": "application-content-test" }],
  "services": [{ "binding": "API", "service": "artroom-lanes-test", "entrypoint": "NetService" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NetScope", "PlatformScope"] }, { "tag": "v2-index", "new_sqlite_classes": ["ScopeIndex"] }]
}
