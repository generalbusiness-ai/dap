// Self-host template. Copy to wrangler.self-host.jsonc before editing.
// docs/self-host.md names the settings and secrets the operator supplies.
// A fresh Worker starts in enforce mode with its own Durable Object namespaces.
// No project bucket, metrics dataset, register or credential belongs here.
{
  "name": "dap-self-host",
  "main": "worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "vars": {
    "SCOPE_INDEX_MODE": "enforce",
    "ARTIFACTS_NAMESPACE": "dap-self-host",
    "APPLICATION_SCREEN_HOSTS": "[]",
    "SERVING_CREATION_KEY_PER_HOUR": "10",
    "SERVING_CREATION_ADDRESS_PER_HOUR": "30",
    "SERVING_READ_KEY_PER_MINUTE": "240",
    "SERVING_READ_ADDRESS_PER_MINUTE": "600"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
  "version_metadata": { "binding": "VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "SCOPES", "class_name": "DeployedScope" },
      { "name": "SCOPE_INDEX", "class_name": "ScopeIndex" },
      { "name": "REGISTRIES", "class_name": "McpRegistry" },
      { "name": "AGENTS", "class_name": "McpAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeployedScope"] },
    { "tag": "v2", "new_sqlite_classes": ["McpRegistry", "McpAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["ScopeIndex"] }
  ],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "dap-self-host", "remote": true }]
}
