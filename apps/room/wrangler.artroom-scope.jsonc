// Existing artroom-scope rooms only. New rooms use dap-demo.
// Retained Start requests ended on 8 November 2026 (PD-6).
// The planner owns deployment and removal of the three GitHub secrets.
// Preserve this Worker's bindings and migration history.
{
  "name": "artroom-scope",
  "main": "worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "vars": {
    // Enforce since 11 November 2026 (request fa21cfa5). The Worker refuses
    // a scope that the index does not list. Deploy with no --var override
    // of this setting.
    "SCOPE_INDEX_MODE": "enforce",
    // No active screen installation is known in this Worker.
    "APPLICATION_SCREEN_HOSTS": "[]",
    "SERVING_CREATION_KEY_PER_HOUR": "10",
    "SERVING_CREATION_ADDRESS_PER_HOUR": "30",
    "SERVING_READ_KEY_PER_MINUTE": "240",
    "SERVING_READ_ADDRESS_PER_MINUTE": "600"
  },
  // Source preparation only; deployment remains separately authorized.
  // Retain allowlisted console diagnoses without platform URL invocation logs.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "artroom_metrics_v1" }],
  "version_metadata": { "binding": "VERSION_METADATA" },
  // Private content only. The operator provisions this bucket; no public R2 route.
  "r2_buckets": [{ "binding": "APPLICATION_CONTENT", "bucket_name": "artroom-application-content" }],
  // APPLICATION_TRUST is an operator-set exact release/publisher/host JSON list.
  "durable_objects": {
    "bindings": [
      { "name": "SCOPES", "class_name": "DeployedScope" },
      { "name": "SCOPE_INDEX", "class_name": "ScopeIndex" },
      // The hosted MCP endpoint: one registry per repository, one object per agent (docs/mcp.md, "The hosted endpoint").
      { "name": "REGISTRIES", "class_name": "McpRegistry" },
      { "name": "AGENTS", "class_name": "McpAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeployedScope"] },
    { "tag": "v2", "new_sqlite_classes": ["McpRegistry", "McpAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["ScopeIndex"] }
  ],
  // Artifacts: one namespace, reached by the binding
  // ARTIFACTS. It takes effect only with operator-set ARTIFACTS_CONFIG.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "artroom-demo", "remote": true }]
}
