// Explicit hosted rollout input; always name this file with --config.
// The conservative default wrangler.jsonc remains unchanged and fails closed.
// Add only descriptors confirmed against their active installation and release,
// with an exact matching APPLICATION_SCREEN_HOSTS row in the fixed room service.
{
  "name": "dap-application-sandbox",
  "main": "worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "routes": [{ "pattern": "*.inguz.space/*", "zone_name": "inguz.space" }],
  "services": [
    { "binding": "ROOM", "service": "artroom-scope", "entrypoint": "ApplicationScreenService" },
    { "binding": "GROW", "service": "dap-grow", "entrypoint": "ApplicationScreenService" },
    { "binding": "LENDING", "service": "dap-lending", "entrypoint": "ApplicationScreenService" }
  ],
  // Confirmed item 2 screens for Grow, both Lending rooms and Counter are mapped. Room remains closed.
  "vars": { "SCREEN_HOSTS": "[{\"host\":{\"v\":1,\"screenOrigin\":\"https://grow.inguz.space\",\"roomOrigin\":\"https://dap-grow.inguz.workers.dev\",\"directory\":\"sc_cu5bjlh3rt4jvcffbxoyu4wye4ckwdf6nyxlpo4adihughrr4ztq\",\"item\":2,\"presentation\":\"sha256:2a3adecf80d11e4734d1b63fc43121e7e73197ee16c3448782cec15e586ef78c\"},\"service\":\"GROW\"},{\"host\":{\"v\":1,\"screenOrigin\":\"https://lending.inguz.space\",\"roomOrigin\":\"https://dap-lending.inguz.workers.dev\",\"directory\":\"sc_5hagamavauu5lcejxqxqkd6xl3ol26bke2ipkhaiwxtxono2gujq\",\"item\":2,\"presentation\":\"sha256:7217583c00c0548755faa3a83ee9fef194a354624dd29dccf62a7c79cbfd48ef\"},\"service\":\"LENDING\"},{\"host\":{\"v\":1,\"screenOrigin\":\"https://counter.inguz.space\",\"roomOrigin\":\"https://dap-lending.inguz.workers.dev\",\"directory\":\"sc_rgtlrioy5eckfikcapmqdteiw7y4b4lrc7k6use4rqdktn4lnabq\",\"item\":11,\"presentation\":\"sha256:9334159c91ea2df5d25e75aaa265b0ccb8b8ceac7a564b8eb46d0b7be57d2af4\"},\"service\":\"LENDING\"},{\"host\":{\"v\":1,\"screenOrigin\":\"https://lending-shelf.inguz.space\",\"roomOrigin\":\"https://dap-lending.inguz.workers.dev\",\"directory\":\"sc_a7fawlxbqabykqatabrx2ldhx4ufji2s4wlm6l4mh5krmqvrzrta\",\"item\":2,\"presentation\":\"sha256:188f7b84e6b1ba29c2090265f4d7884a29884beff6ea58774a34ce8fbeef9f81\"},\"service\":\"LENDING\"}]" },
  "observability": { "enabled": false }
}
